{
  "name": "@writavo/mcp-server",
  "version": "0.5.0",
  "private": true,
  "mcpName": "com.writavo/cms",
  "description": "MCP server for the Writavo Content API, hosted at https://mcp.writavo.com/mcp (Streamable HTTP, OAuth sign-in in the browser, nothing to install): import an existing blog, and draft, edit, organise, schedule and publish a Site's content from any AI assistant, with tools generated from the published OpenAPI specification. This workspace package is private: the hosted server bundles its ./core export.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cms",
    "writavo",
    "content-api",
    "headless-cms",
    "blogging",
    "remote-mcp",
    "streamable-http"
  ],
  "license": "MIT",
  "author": "Writavo",
  "homepage": "https://writavo.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/SparkleOfficial/writavo-mcp-server.git"
  },
  "bugs": {
    "url": "https://writavo.com/support"
  },
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/gen-mcp-tools.mjs --check && tsc",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "smoke": "tsx scripts/smoke.ts",
    "integration": "tsx scripts/integration.ts",
    "test": "npm run smoke",
    "gen": "node scripts/gen-mcp-tools.mjs",
    "gen:check": "node scripts/gen-mcp-tools.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hast-util-from-html": "^2",
    "hast-util-to-mdast": "^10",
    "mdast-util-from-markdown": "^2",
    "mdast-util-gfm": "^3",
    "mdast-util-to-markdown": "^2",
    "mdast-util-to-string": "^4",
    "micromark-extension-gfm": "^3",
    "saxes": "^6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/hast": "^3",
    "@types/mdast": "^4",
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
